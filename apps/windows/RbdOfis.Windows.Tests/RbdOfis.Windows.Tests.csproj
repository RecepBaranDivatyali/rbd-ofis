<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RbdOfis.Interop\RbdOfis.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Condition="Exists('..\..\..\core\target\release\rbd_ffi.dll')" Include="..\..\..\core\target\release\rbd_ffi.dll">
      <Link>rbd_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Condition="!Exists('..\..\..\core\target\release\rbd_ffi.dll') and Exists('..\..\..\core\target\debug\rbd_ffi.dll')" Include="..\..\..\core\target\debug\rbd_ffi.dll">
      <Link>rbd_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Condition="Exists('..\..\..\core\vendor\pdfium\bin\pdfium.dll')" Include="..\..\..\core\vendor\pdfium\bin\pdfium.dll">
      <Link>pdfium.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

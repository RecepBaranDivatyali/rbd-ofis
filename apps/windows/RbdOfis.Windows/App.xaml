<Application x:Class="RbdOfis.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RbdOfis.Windows">
    <Application.Resources>
        <!-- Fluent Dark Theme Brushes (Default) -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AppForegroundBrush" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="MutedForegroundBrush" Color="#858585"/>
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#252526"/>
        <SolidColorBrush x:Key="TabStripBackgroundBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="SubToolbarBackgroundBrush" Color="#252526"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#252526"/>
        <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#181818"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#0E639C"/>
        <SolidColorBrush x:Key="SuccessButtonBrush" Color="#107C41"/>
        <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#007ACC"/>
    </Application.Resources>
</Application>
